# Server Configuration
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Application
APP_NAME=FocusFlow API
APP_VERSION=1.1.0
RELEASE_MESSAGE=FocusFlow full-stack release 1.1.0

# Logging
LOG_LEVEL=info

# CORS (comma-separated for multiple origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER_URL/focusflow?retryWrites=true&w=majority

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

CORS_ORIGIN=http://localhost:5173,http://localhost:3000